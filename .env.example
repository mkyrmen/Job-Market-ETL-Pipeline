# =====================================================================
# Job Market Intelligence Platform — environment configuration
# Copy this file to `.env` and fill in the values you need.
# Never commit `.env`.
# =====================================================================

# Logging
LOG_LEVEL=INFO

# ---- ETL defaults ---------------------------------------------------
ETL_LIMIT=100
REQUEST_TIMEOUT_SECONDS=25
MAX_HTTP_RETRIES=3
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36

# ---- Supabase (production persistence) ------------------------------
# Optional: if unset, the ETL runs in local SQLite-only mode.
# Create a project at https://supabase.com, run supabase/migrations/*.sql
# in the SQL editor, then add credentials here.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional direct Postgres connection string, e.g.
# postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:5432/postgres
DATABASE_URL=